# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bromo?schema=public"

# --- NextAuth ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- App ---
# Root and merchant hosts used by subdomain middleware.
# In dev, point merchant.localhost to 127.0.0.1 (already does on most systems).
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_MERCHANT_SUBDOMAIN="merchant"
